# ── Build output ────────────────────────────────────────────────────────────
bin/
obj/
out/

# ── Visual Studio ────────────────────────────────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser

# ── NuGet ────────────────────────────────────────────────────────────────────
packages/
*.nupkg
project.lock.json
project.assets.json

# ── Resharper ────────────────────────────────────────────────────────────────
_ReSharper*/
*.DotSettings.user

# ── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── OS X ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Logs & temp ──────────────────────────────────────────────────────────────
*.log
*.tmp
*.temp

# ── LocalDB / SQL Server data files (runtime, not scripts) ───────────────────
# Файлы самой БД не заливаем — только SQL-скрипты
*.mdf
*.ldf
*.ndf
